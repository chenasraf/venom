{
  "name": "venom",
  "version": "0.0.1",
  "description": "",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "bot": "src/scripts/systemctl.zsh bot",
    "db": "src/scripts/systemctl.zsh db",
    "logs": "pnpm bot logs",
    "dblogs": "pnpm db logs",
    "build": "tsc && tsc-alias",
    "gen": "simple-scaffold -c scaffold.config.js -k",
    "install-services": "src/scripts/install-services.zsh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "csv": "^6.6.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "simple-scaffold": "^3.1.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "megahal.js": "^1.0.3",
    "mongodb": "^7.3.0",
    "nanoid": "^5.1.11",
    "winston": "^3.19.0"
  },
  "nodemonConfig": {
    "ignore": [
      "build/**"
    ]
  }
}
